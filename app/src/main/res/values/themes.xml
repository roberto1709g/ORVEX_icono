<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
        <item name="android:windowBackground">#070B14</item>
    </style>

    <style name="OrvexWakeTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#00E5FF</item>
    </style>
</resources>
